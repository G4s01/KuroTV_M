{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuro-tv",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kuro-tv"
    }
  ]
}
