# ==============================================================================
# KuroTV - Configurazione Variabili d'Ambiente & Cloudflare R2 OTA Updater
# ==============================================================================
# Copia questo file in `.env.local` per la compilazione e il rilascio locale,
# oppure in `.env` per le impostazioni di default durante lo sviluppo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurazione OTA Updater Client (Expo)
# ------------------------------------------------------------------------------
# URL da cui l'applicazione Android TV scarica il manifest.json
# - Nuovo metodo con Worker protetto: https://kuro-tv.<subdomain>.workers.dev/manifest.json
# - Metodo legacy bucket pubblico: https://r2.kurotv.app/manifest.json
EXPO_PUBLIC_UPDATE_MANIFEST_URL=https://kuro-tv.<subdomain>.workers.dev/manifest.json

# Token segreto opzionale per l'autenticazione con il Worker kuro-tv
EXPO_PUBLIC_OTA_TOKEN=your_ota_secret_token

# ------------------------------------------------------------------------------
# 2. Configurazione Cloudflare Worker kuro-tv & R2 Privato (build-release.sh)
# ------------------------------------------------------------------------------
# Token API Cloudflare con permessi Workers e R2 (consente deploy e upload diretto con Wrangler)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Nome del nuovo bucket R2 privato (NON abilitare public access su questo bucket)
R2_PRIVATE_BUCKET_NAME=kuro-tv

# URL del Worker kuro-tv che eroga i file dal bucket privato
OTA_WORKER_URL=https://kuro-tv.<subdomain>.workers.dev

# Token segreto configurato sul Worker kuro-tv via `wrangler secret put OTA_SECRET_TOKEN`
OTA_SECRET_TOKEN=your_ota_secret_token

# ------------------------------------------------------------------------------
# 3. Configurazione Cloudflare R2 Legacy (Transitorio durante la migrazione)
# ------------------------------------------------------------------------------
# Mantenere queste variabili finché tutti gli utenti hanno aggiornato alla nuova versione
R2_BUCKET_NAME=kurotv-releases
R2_PUBLIC_URL=https://r2.kurotv.app

# ID Account Cloudflare (reperibile nella dashboard Cloudflare -> R2)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Chiave di accesso API R2 (S3 compatible Access Key ID)
R2_ACCESS_KEY_ID=your_r2_access_key_id

# Chiave segreta API R2 (S3 compatible Secret Access Key)
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Endpoint S3-compatibile per Cloudflare R2
# Formato: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 4. Configurazione Backup Cloud Sicuro (scripts/backup-secrets-r2.sh)
# ------------------------------------------------------------------------------
# Bucket R2 dedicato per i backup cifrati (NON associato ad alcun Worker)
R2_BACKUP_BUCKET_NAME=kurotv-backups

# Passphrase master per la cifratura lato client AES-256-CBC (Zero-Knowledge)
BACKUP_ENCRYPTION_PASSPHRASE=your_secure_backup_passphrase

