{
  "name": "kurom",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android": "expo run:android --variant release",
    "test": "tsc --noEmit && node --experimental-strip-types --loader ./tests/test-loader.mjs tests/core-verification.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "release": "./scripts/build-release.sh",
    "postinstall": "node scripts/apply-patches.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native/normalize-colors": "0.88.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-screen-orientation": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-edge-to-edge": "^1.4.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-unistyles": "3.8.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-edge-to-edge"
        ]
      }
    }
  },
  "private": true
}
